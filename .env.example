# ── Base de datos ───────────────────────────────────────────
# Usá la URL directa de Supabase (puerto 5432, sin pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase Auth ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ── Bot de Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN="[TOKEN_DE_BOTFATHER]"
TELEGRAM_ADMIN_CHAT_ID="[TU_CHAT_ID]"
TELEGRAM_SECRET="[HEX_32_CHARS_ALEATORIO]"

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="[CLOUD_NAME]"
CLOUDINARY_API_KEY="[API_KEY]"
CLOUDINARY_API_SECRET="[API_SECRET]"

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY="[API_KEY]"

# ── AstroPay ─────────────────────────────────────────────────
ASTROPAY_API_KEY="[API_KEY]"
ASTROPAY_SECRET="[SECRET]"
ASTROPAY_MERCHANT_CODE="[MERCHANT_CODE]"

# ── N8N ──────────────────────────────────────────────────────
N8N_SECRET="[HEX_32_CHARS_ALEATORIO]"

# ── Datos bancarios (transferencias) ─────────────────────────
CBU="[CBU_BANCARIO]"
ALIAS_CBU="[ALIAS_BANCARIO]"
TITULAR_CUENTA="[NOMBRE_TITULAR]"

# ── Contacto público (página /contacto + pedido) ─────────────────────
NEXT_PUBLIC_CONTACT_EMAIL="hola@valentinalucia.com.ar"
NEXT_PUBLIC_CONTACT_INSTAGRAM="valentinalucia.store"
NEXT_PUBLIC_CONTACT_WHATSAPP="+5491100000000"

# ── Contacto (se muestra en la página de pedido por transferencia) ───
CONTACT_PHONE="+54 9 11 1234-5678"
INSTAGRAM_HANDLE="valentinalucia.store"

# ── Andreani ─────────────────────────────────────────────────
ANDREANI_USERNAME="[USUARIO_ANDREANI]"
ANDREANI_PASSWORD="[PASSWORD_ANDREANI]"
ANDREANI_CONTRACT="[NUMERO_DE_CONTRATO]"
ANDREANI_ORIGIN_CP="2000"               # CP del local/depósito de VALENTINA LUCIA
ANDREANI_PACKAGE_WEIGHT_KG="0.5"        # peso estimado por paquete en kg
ANDREANI_API_BASE="https://apis.andreani.com"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
